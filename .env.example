PORT=3000

HYDRADB_HTTP_URL=http://127.0.0.1:8443
HYDRADB_GRAPH_ID=default
HYDRADB_NAMESPACE=default
HYDRADB_CELL_ID=cell-0
HYDRADB_AUTH_TOKEN=local-development-token-32-bytes

# Optional: semantic conflict detection (src/lib/conflictClassifier.ts) and
# LongMemEval fact extraction (src/ingest/extractFacts.ts) use whichever of
# these is set, in this order. Set AT MOST ONE -- if none are set, both
# features fall back to their non-LLM path automatically (exact-string
# conflict detection; extraction simply isn't available). Never commit a
# real key here -- this file is the template, not where secrets live.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite

# Gemini only: instead of GEMINI_API_KEY, set GEMINI_API_KEYS (plural) to a
# comma- or newline-separated list of keys from SEPARATE Google Cloud
# projects (the free tier's 15 req/min + ~500 req/day quota is per-project,
# not per-key -- multiple keys under one project share the same limit and
# won't help; confirmed live via a real 429 body's `quotaId:
# GenerateRequestsPerDayPerProjectPerModel-FreeTier`). The provider
# round-robins across them and automatically benches whichever one just hit
# a 429, moving to the next -- useful for a large batch ingest that would
# otherwise stall on one project's quota.
# GEMINI_API_KEYS=key-from-project-1,key-from-project-2,key-from-project-3
