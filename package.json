{
  "name": "lethe",
  "version": "0.1.0",
  "description": "A temporal, self-correcting agent memory system on HydraDB",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "lint": "eslint src scripts test --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed.ts",
    "baseline:eval": "tsx scripts/run-baseline-comparison.ts",
    "ingest:longmemeval": "tsx scripts/ingest-longmemeval.ts",
    "eval:longmemeval": "tsx scripts/eval-longmemeval.ts",
    "ingest:temporal-facts": "tsx scripts/ingest-temporal-facts.ts",
    "eval:temporal-facts": "tsx scripts/eval-temporal-facts.ts",
    "ingest:templama": "cross-env DATASET_NAME=templama DATA_PATH=data/templama/subset.json tsx scripts/ingest-temporal-facts.ts",
    "eval:templama": "cross-env DATASET_NAME=templama tsx scripts/eval-temporal-facts.ts",
    "ingest:dynamic-templama": "cross-env DATASET_NAME=dynamic-templama DATA_PATH=data/dynamic-templama/subset.json tsx scripts/ingest-temporal-facts.ts",
    "eval:dynamic-templama": "cross-env DATASET_NAME=dynamic-templama tsx scripts/eval-temporal-facts.ts",
    "ingest:art-provenance": "cross-env DATASET_NAME=art-provenance DATA_PATH=data/art-provenance/subset.json tsx scripts/ingest-temporal-facts.ts",
    "eval:art-provenance": "cross-env DATASET_NAME=art-provenance tsx scripts/eval-temporal-facts.ts",
    "ingest:ceo-succession": "cross-env DATASET_NAME=ceo-succession DATA_PATH=data/ceo-succession/subset.json tsx scripts/ingest-temporal-facts.ts",
    "eval:ceo-succession": "cross-env DATASET_NAME=ceo-succession tsx scripts/eval-temporal-facts.ts",
    "ingest:beam": "tsx scripts/ingest-beam.ts",
    "eval:beam": "tsx scripts/eval-beam.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "cross-env": "^10.1.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
